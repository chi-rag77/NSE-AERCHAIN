# ── Frontend (Vite) — safe to expose, protected by RLS ──────────────────────
# The dashboard reads tickets from Supabase using these. Each customer instance
# points at that customer's own Supabase project.
VITE_SUPABASE_URL=https://<PROJECT_REF>.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Per-customer label shown across the UI (e.g. NSE, Meta, Danone, Unilever).
# Must match the sync's FRESHDESK_COMPANY_NAME (the cf_company value).
VITE_COMPANY_NAME=NSE
# Optional full legal name used on the login screen subtitle.
VITE_COMPANY_FULL_NAME=National Stock Exchange

# ── Edge Function secrets (server-side only — DO NOT put in frontend .env) ───
# Set these with the Supabase CLI, never commit them:
#   supabase secrets set FRESHDESK_DOMAIN=aerchain.freshdesk.com
#   supabase secrets set FRESHDESK_API_KEY=your_freshdesk_api_key
#   supabase secrets set FRESHDESK_COMPANY_NAME=NSE   # cf_company to sync (Meta/Danone/…)
#   supabase secrets set SYNC_CREATED_AFTER=2026-07-27T00:00:00Z  # optional
#   supabase secrets set SYNC_CONVERSATIONS=true      # optional
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically.
